Panels:
- Class: rviz_common/Displays
  Name: Displays
- Class: rviz_common/Tool Properties
  Name: Tool Properties
- Class: rviz_common/Views
  Name: Views
Visualization Manager:
  Class: ''
  Global Options:
    Background Color: 25; 28; 34
    Fixed Frame: map
    Frame Rate: 30
  Displays:
  - Class: rviz_default_plugins/MarkerArray
    Name: 01 MGeo Roads - visible background
    Enabled: true
    Topic:
      Value: /route_editor/mgeo_links
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
      Depth: 1
  - Class: rviz_default_plugins/MarkerArray
    Name: 02 MGeo Nodes - optional editing
    Enabled: false
    Topic:
      Value: /route_editor/mgeo_nodes
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
      Depth: 1
  - Class: rviz_default_plugins/Marker
    Name: 03 Global Path - BRIGHT GREEN
    Enabled: true
    Topic:
      Value: /planning/global_path_marker
      Reliability Policy: Reliable
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 1
  - Class: rviz_default_plugins/Marker
    Name: 04 Current Lane - BLUE
    Enabled: true
    Topic:
      Value: /planning/current_lane_marker
      Reliability Policy: Reliable
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 1
  - Class: rviz_default_plugins/Marker
    Name: 04b Original Lane - CYAN context
    Enabled: true
    Topic:
      Value: /planning/original_lane_marker
      Reliability Policy: Reliable
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 1
  - Class: rviz_default_plugins/Marker
    Name: 05 Left Adjacent Center - YELLOW
    Enabled: true
    Topic:
      Value: /planning/left_lane_marker
      Reliability Policy: Reliable
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 1
  - Class: rviz_default_plugins/Marker
    Name: 06 Local Path - CONTROL follows WHITE
    Enabled: true
    Topic:
      Value: /planning/local_path_marker
      Reliability Policy: Reliable
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 1
  - Class: rviz_default_plugins/Marker
    Name: 07 Selected Avoidance - CYAN stripe
    Enabled: true
    Topic:
      Value: /planning/avoidance_selected_marker
      Reliability Policy: Reliable
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 1
  - Class: rviz_default_plugins/Marker
    Name: 08 Right Adjacent Center - ORANGE
    Enabled: true
    Topic:
      Value: /planning/right_lane_marker
      Reliability Policy: Reliable
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 1
  - Class: rviz_default_plugins/Marker
    Name: 09 Reserved Return Path - PINK stripe
    Enabled: true
    Topic:
      Value: /planning/avoidance_return_marker
      Reliability Policy: Reliable
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 1
  - Class: rviz_default_plugins/MarkerArray
    Name: 09b Lattice Candidates - Cost and Rejection Reasons
    Enabled: true
    Topic:
      Value: /planning/lattice_candidate_markers
      Reliability Policy: Reliable
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 1
  - Class: rviz_default_plugins/MarkerArray
    Name: 10 Obstacles - ORANGE closed footprints
    Enabled: true
    Topic:
      Value: /planning/obstacle_footprint_markers
      Reliability Policy: Reliable
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 1
  - Class: rviz_default_plugins/Marker
    Name: 11 Ego Vehicle - RED, fresh
    Enabled: true
    Topic:
      Value: /planning/ego_vehicle_marker
      Reliability Policy: Reliable
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 1
  - Class: rviz_default_plugins/MarkerArray
    Name: 12 Selected Waypoints - draft
    Enabled: true
    Topic:
      Value: /route_editor/waypoint_markers
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
      Depth: 1
  - Class: rviz_default_plugins/Path
    Name: 13 Draft Preview - NOT active route
    Enabled: false
    Color: 255; 70; 230
    Line Style: Billboards
    Line Width: 0.25
    Buffer Length: 1
    Topic:
      Value: /route_editor/preview_path
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
      Depth: 1
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/PublishPoint
    Topic: /clicked_point
    Single click: false
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: K-City S4 Lane Change
      Target Frame: map
      Angle: 0
      Scale: 20.0
      X: 142.0
      Y: 1444.0
Window Geometry:
  Width: 1500
  Height: 1000
