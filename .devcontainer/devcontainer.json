{
    "name": "EdgeNode ROS2 Humble",

    "dockerComposeFile": "../compose.yaml",

    "service": "autonomous",

    "workspaceFolder": "/workspace",

    "remoteUser": "dev",

    "shutdownAction": "stopCompose",

    "postCreateCommand": "git config --global --replace-all safe.directory /workspace",

    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-iot.vscode-ros",
                "redhat.vscode-yaml"
            ]
        }
    }
}
